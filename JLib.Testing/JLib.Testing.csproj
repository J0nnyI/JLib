        <PackageTags>JLib;testing;snapshot;snapshooter;xunit;dependency-injection;reflection;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
