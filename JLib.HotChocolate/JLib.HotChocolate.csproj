<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <Description>HotChocolate GraphQL integration for JLib. Provides type cache driven discovery of GraphQL type extensions and query data object types, resolver context helpers for batched data loading of JLib data objects via EF Core, and a logging diagnostics event listener.</Description>
        <PackageTags>JLib;HotChocolate;GraphQL;dataloader;EntityFrameworkCore;reflection;dotnet</PackageTags>
    </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.Data" />
    <PackageReference Include="HotChocolate.Execution" />
    <PackageReference Include="HotChocolate.Execution.Abstractions" />
    <PackageReference Include="HotChocolate.Types" />
      <!--used for GetOneDataObjectAsync-->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--<PackageReference Include="Microsoft.EntityFrameworkCore" />-->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JLib.DataProvider\JLib.DataProvider.csproj" />
  </ItemGroup>

</Project>

