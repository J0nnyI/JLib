<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>True</IsPackable>
        <Description>Provides Entity Framework Core ValueConverters for JLib ValueTypes, allowing strongly typed ValueTypes (backed by class or struct values) to be used directly as properties on EF Core entities.</Description>
        <PackageTags>JLib;efcore;entity-framework-core;value-converter;value-types;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\JLib.Reflection\JLib.Reflection.csproj" />
      <ProjectReference Include="..\JLib.ValueTypes\JLib.ValueTypes.csproj" />
    </ItemGroup>

</Project>

