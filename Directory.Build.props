<Project>
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>

        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>

        <Version>$(VersionSuffix)</Version>
        <AssemblyVersion>$(VersionSuffix)</AssemblyVersion>
        <FileVersion>$(VersionSuffix)</FileVersion>
        <Company>-</Company>
        <Authors>Marcel Rehkemper</Authors>
        <Title>$(MSBuildProjectName)</Title>

        <PackageAssemblies>
            JLib.DataGeneration
            JLib.DataGeneration.Abstractions
            JLib.DataProvider
            JLib.DataProvider.AutoMapper
            JLib.DataProvider.EfCore
            JLib.DataProvider.InMemory
            JLib.DependencyInjection
            JLib.Reflection
            JLib.Reflection.DependencyInjection
            JLib.Reflection.HotChocolate.Query
            JLib.ValueTypes
            JLib.ValueTypes.Mapping
            JLib.ValueTypes.Implementations.FileSystem
            JLib
            JLib.AutoMapper
            JLib.Configuration
            JLib.Cqrs
            JLib.EfCore
            JLib.Exceptions
            JLib.Helper
            JLib.HotChocolate
            JLib.Testing
            JLib.SystemTextJson
            JLib.AspNetCore
        </PackageAssemblies>

    </PropertyGroup>

    <Choose>
        <!--Library Projects-->
        <When Condition="$(PackageAssemblies.Contains($(MSBuildProjectName)))">
            <PropertyGroup >
                <IsPackable>true</IsPackable>
                <!--use dotnet pack to generate packages-->
                <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
                <PackageProjectUrl>https://github.com/jonnyIV/jlib</PackageProjectUrl>
                <PackageLicenseExpression>MIT</PackageLicenseExpression>
                <IncludeSymbols>True</IncludeSymbols>
                <RepositoryUrl>https://github.com/JonnyIV/JLib</RepositoryUrl>
                <PackageReadmeFile>$(MSBuildProjectName) Documentation.md</PackageReadmeFile>
                <GenerateDocumentationFile>True</GenerateDocumentationFile>
            </PropertyGroup>
            <ItemGroup>
                <!--Include documentation-->
                <None Include="$(MSBuildProjectName) Documentation.md">
                    <Pack>True</Pack>
                    <PackagePath>\</PackagePath>
                </None>
            </ItemGroup>
        </When>

        <!--Test Projects-->
        <When  Condition="$(MSBuildProjectName.EndsWith('Tests')) 
               or ($(MSBuildProjectName.EndsWith('Testing')) and !$(PackageAssemblies.Contains($(MSBuildProjectName))) ) 
               or $(MSBuildProjectName.EndsWith('.Benchmarks'))">
            <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Testing'))">
                <IsPackable>false</IsPackable>
                <IsTestProject>true</IsTestProject>
            </PropertyGroup>
            <ItemGroup>
                <!--Setup-->
                <PackageReference Include="Microsoft.NET.Test.Sdk" />
                <PackageReference Include="xunit" />
                <PackageReference Include="xunit.abstractions" />
                <PackageReference Include="xunit.assert" />
                <PackageReference Include="xunit.runner.visualstudio">
                    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
                    <PrivateAssets>all</PrivateAssets>
                </PackageReference>
                <PackageReference Include="coverlet.collector">
                    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
                    <PrivateAssets>all</PrivateAssets>
                </PackageReference>
                <!--test methods-->
                <PackageReference Include="Snapshooter.Xunit" />
                <PackageReference Include="FluentAssertions" />
                <PackageReference Include="Moq" />
                <!--logging-->
                <PackageReference Include="Microsoft.Extensions.Logging" />
                <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
                <PackageReference Include="Xunit.Extensions.Logging" />
                <!--dependency injection-->
                <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
            </ItemGroup>
        </When>
    </Choose>

    <Choose>
        <When Condition="$(AssemblyName.EndsWith('.Benchmarks'))">
            <PropertyGroup>
                <OutputType>Exe</OutputType>
                <DebugType>pdbonly</DebugType>
                <DebugSymbols>true</DebugSymbols>
                <Optimize>true</Optimize>
                <GenerateProgramFile>false</GenerateProgramFile>
            </PropertyGroup>
            <ItemGroup >
                <PackageReference Include="BenchmarkDotNet" />
                <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" />
                <PackageReference Include="BenchmarkDotNet.TestAdapter" />
                <PackageReference Include="Lib.Harmony" />
            </ItemGroup>
        </When>
    </Choose>

    <!--makes the internals of a project visible to its tests-->
    <ItemGroup Condition="!$(AssemblyName.EndsWith('.Tests')) and !$(AssemblyName.EndsWith('.Benchmarks'))">
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(AssemblyName).Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>