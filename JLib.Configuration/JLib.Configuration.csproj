<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <IsPackable>true</IsPackable>
      <Description>Reflection-based configuration section access for Microsoft.Extensions.Configuration. Discovers classes marked with ConfigSectionNameAttribute via the JLib type cache and registers them in the dependency injection container or retrieves them directly, with environment-aware section selection.</Description>
      <PackageTags>JLib;configuration;options;dependency-injection;reflection;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JLib.Reflection\JLib.Reflection.csproj" />
  </ItemGroup>

</Project>

