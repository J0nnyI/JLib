<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
      <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AutoMapper" Version="16.*" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.*" />
    <PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.*" />
    <PackageVersion Include="BenchmarkDotNet.TestAdapter" Version="0.*" />
    <PackageVersion Include="coverlet.collector" Version="6.*" />
    <PackageVersion Include="FluentAssertions" Version="[7,)" />
    <PackageVersion Include="HotChocolate.Data" Version="15.*" />
    <PackageVersion Include="HotChocolate.Execution" Version="15.*" />
    <PackageVersion Include="HotChocolate.Execution.Abstractions" Version="15.*" />
    <PackageVersion Include="HotChocolate.Types" Version="15.*" />
    <PackageVersion Include="Lib.Harmony" Version="2.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.*" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageVersion Include="Moq" Version="4.*" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.*" />
    <PackageVersion Include="Snapshooter.Xunit" Version="1.*" />
    <PackageVersion Include="xunit" Version="2.*" />
    <PackageVersion Include="xunit.abstractions" Version="2.*" />
    <PackageVersion Include="xunit.assert" Version="2.*" />
    <PackageVersion Include="Xunit.Extensions.Logging" Version="1.*" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.*" />
  </ItemGroup>
</Project>